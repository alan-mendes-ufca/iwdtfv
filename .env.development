NODE_ENV=development

# Binário do yt-dlp. Nos testes (`npm test`) é trocado por tests/fakes/yt-dlp.ts.
YTDLP_BINARY=yt-dlp

# Arquivo de cookies (formato Netscape) para Instagram/X. Nunca versionar o arquivo.
YTDLP_COOKIES_FILE=

# Runtime JS do YouTube (ex.: node). Vazio = padrão do yt-dlp (deno).
YTDLP_JS_RUNTIMES=

# Diretório-base dos temporários. Vazio = <tmp do sistema>/iwdtfv
TEMP_DIR=

MAX_DURATION_SECONDS=7200
MAX_FILESIZE_BYTES=2147483648
INSPECT_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=900000
MAX_CONCURRENT_DOWNLOADS=2

RATE_LIMIT_INSPECT_PER_MINUTE=20
RATE_LIMIT_DOWNLOAD_PER_MINUTE=5

# 1 = confiar no X-Forwarded-For (só atrás de um proxy reverso seu)
TRUST_PROXY=0
